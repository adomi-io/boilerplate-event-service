# Development settings; docker compose reads this file. In production hand the same names to the
# containers as environment variables.

# The broker: one vhost per service
RABBITMQ_SCHEME=amqp
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=events
RABBITMQ_PASSWORD=events
RABBITMQ_VHOST=event_service
RABBITMQ_EXCHANGE=events

# The worker's queue and what it binds (# = every event on the exchange)
RABBITMQ_QUEUE=event_service_worker
RABBITMQ_ROUTING_KEY=#

# How many messages the worker runs at once; above 1 your handlers must be thread safe
RABBITMQ_PREFETCH=1

# A failed message is tried again this many times, this many seconds apart, then parked in <queue>.parked
RABBITMQ_MAX_RETRIES=5
RABBITMQ_RETRY_DELAY=30

# When set, POST /action requires a matching X-API-Key header
SERVICE_API_KEY=

# The outside API the worker talks to
# TEMPLATE: rename TARGET_* after the API you call
TARGET_API_URL=
TARGET_API_KEY=
TARGET_API_TIMEOUT=30

# Ports on your machine (compose only)
API_PORT=5001
RABBITMQ_MANAGEMENT_PORT=15672

TZ=UTC
LOG_LEVEL=INFO
